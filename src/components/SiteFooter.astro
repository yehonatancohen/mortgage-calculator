---
import { SITE } from '../config/site';
import { CALCULATORS } from '../config/calculators';
const year = 2026;
const groups = [
  {
    title: 'מחשבונים',
    links: [
      ...CALCULATORS.map((c) => [c.path, c.short]),
      ['/calculators/', 'כל המחשבונים'],
    ],
  },
  {
    title: 'מידע',
    links: [
      ['/ribit-mashkanta-hayom/', 'ריבית משכנתא היום'],
      ['/questions/', 'שאלות ותשובות'],
      ['/guides/', 'מדריכים'],
      ['/banks/', 'מחזור לפי בנק'],
      ['/methodology/', 'איך אנחנו מחשבים'],
    ],
  },
  {
    title: 'עלינו',
    links: [
      ['/about/', 'אודות'],
      ['/how-we-make-money/', 'איך אנחנו מרוויחים'],
      ['/privacy/', 'מדיניות פרטיות'],
      ['/terms/', 'תנאי שימוש'],
      ['/accessibility/', 'הצהרת נגישות'],
    ],
  },
];
---
<footer class="site-footer">
  <div class="site-footer__inner">
    <div class="site-footer__about">
      <p class="site-footer__brand">
        <img class="site-footer__mark site-footer__mark--light" src="/logo-icon.png" width="32" height="29" alt="" />
        <img class="site-footer__mark site-footer__mark--dark" src="/logo-icon-white.png" width="32" height="29" alt="" />
        {SITE.brand}
      </p>
      <p>{SITE.tagline}</p>
    </div>
    {groups.map((g) => (
      <nav class="site-footer__group" aria-label={g.title}>
        <h2>{g.title}</h2>
        <ul>{g.links.map(([href, label]) => <li><a href={href}>{label}</a></li>)}</ul>
      </nav>
    ))}
  </div>
  <div class="site-footer__legal">
    <p>המידע והמחשבונים באתר הם הערכה בלבד ואינם ייעוץ פיננסי. <a href="/methodology/">פרטים והנחות</a>.</p>
    <p>© <bdi class="num">{year}</bdi> {SITE.brand}</p>
  </div>
</footer>
