---
import { NAV, SITE } from '../config/site';
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="site-header__inner">
    <a class="brand" href="/" aria-label={`${SITE.brand}: לעמוד הבית`}>
      <img class="brand__mark brand__mark--light" src="/logo-icon.png" width="40" height="36" alt="" />
      <img class="brand__mark brand__mark--dark" src="/logo-icon-white.png" width="40" height="36" alt="" />
      <span>{SITE.brand}</span>
    </a>
    <nav class="site-nav" aria-label="ראשי">
      <ul>
        {NAV.map((item) => (
          <li><a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</header>
