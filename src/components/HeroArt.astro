---
/**
 * Line skyline for the hero band: a Bauhaus apartment block with a rooftop solar water heater,
 * a slim tower and a gabled house, standing on the band's lower edge. Same grammar as Icon.astro
 * (round caps and joins, one stroke weight), drawn in the band's mist ink. Decorative only.
 */
---
<svg class="hero-art" viewBox="0 0 400 220" aria-hidden="true" focusable="false">
  <g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" vector-effect="non-scaling-stroke">
    <!-- tree -->
    <path d="M22 218v-26" />
    <circle cx="22" cy="176" r="16" class="hero-art__fill" />

    <!-- Bauhaus block: ribbon windows, door, solar heater on the roof -->
    <path d="M46 218V78h120v140" class="hero-art__fill" />
    <rect x="58" y="90" width="96" height="12" rx="6" />
    <rect x="58" y="118" width="96" height="12" rx="6" />
    <rect x="58" y="146" width="96" height="12" rx="6" />
    <rect x="58" y="174" width="96" height="12" rx="6" />
    <path d="M100 218v-20h20v20" />
    <path d="M60 78l10-16h10L70 78" />
    <rect x="86" y="60" width="28" height="11" rx="5.5" />
    <path d="M92 71v7M108 71v7" />

    <!-- tower -->
    <path d="M184 218V28h60v190" class="hero-art__fill" />
    <path d="M199 44v158M214 44v158M229 44v158M214 28V14" />

    <!-- house -->
    <path d="M262 218v-62h78v62" class="hero-art__fill" />
    <path d="M254 158l47-40 47 40" />
    <rect x="276" y="170" width="18" height="18" rx="2" />
    <path d="M310 218v-34h18v34" />

    <!-- tree -->
    <path d="M374 218v-20" />
    <circle cx="374" cy="186" r="13" class="hero-art__fill" />

    <!-- ground -->
    <path d="M0 218h400" />
  </g>
</svg>
