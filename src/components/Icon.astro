---
/** Authored icon set: 24px grid, 2px stroke, round caps. Decorative by default. */
type Name = 'check' | 'chevron-down' | 'arrow-left' | 'info' | 'home' | 'calendar' | 'clock' | 'percent' | 'compare' | 'receipt';
interface Props { name: Name; class?: string; label?: string }
const { name, class: cls, label } = Astro.props;
const paths: Record<Name, string> = {
  check: 'M5 12.5l4.5 4.5L19 7.5',
  'chevron-down': 'M6 9.5l6 6 6-6',
  'arrow-left': 'M19 12H5m6-6l-6 6 6 6',
  info: 'M12 16.5v-5m0-3.5h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  // Balance: the home the loan is on.
  home: 'M4 10.5L12 4l8 6.5V19a1 1 0 01-1 1h-4.5v-5.5h-5V20H5a1 1 0 01-1-1v-8.5z',
  // Monthly payment: a month on the calendar.
  calendar: 'M8 3v3.5M16 3v3.5M4 9.5h16M5 5h14a1 1 0 011 1v13a1 1 0 01-1 1H5a1 1 0 01-1-1V6a1 1 0 011-1z',
  // Years left: time.
  clock: 'M12 7.5V12l3 2M21 12a9 9 0 11-18 0 9 9 0 0118 0z',
  percent: 'M18.5 5.5l-13 13M9.5 7.5a2 2 0 11-4 0 2 2 0 014 0zm9 9a2 2 0 11-4 0 2 2 0 014 0z',
  compare: 'M4 20h16M7.5 16.5V11m4.5 5.5V5m4.5 11.5V8.5',
  receipt: 'M6 3.5h12v17l-3-2-3 2-3-2-3 2v-17zM9 8.5h6M9 12.5h6',
};
---
<svg class={cls} viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'}><path d={paths[name]} /></svg>
