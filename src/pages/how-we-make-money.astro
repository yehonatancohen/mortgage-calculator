---
import ProsePage from '../layouts/ProsePage.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config/site';
import { faqLd } from '../seo/schema';

const updated = '2026-09-28';
const faq = [
  { q: 'האם המחשבונים באמת חינמיים?', a: 'כן. אין הרשמה, אין תשלום ואין חובה להשאיר פרטים כדי לראות תוצאה.' },
  { q: 'מי משלם לכם?', a: 'יועץ המשכנתאות העצמאי שאליו מועברת פנייה, ורק כשביקשתם בדיקה בעצמכם. אין תשלום על צפייה במחשבונים.' },
  { q: 'האם היועץ או הבנק משפיעים על התוצאה במחשבון?', a: 'לא. התוצאה מחושבת לפני שמבקשים פרטים, מהנתונים שהזנתם ומנתוני שוק ציבוריים. אף גורם מסחרי אינו יכול לשנות אותה.' },
  { q: 'האם אתם מוכרים את המספר שלי?', a: 'לא. מי שמבקש בדיקה מועבר ליועץ אחד בלבד, והמספר לא נמכר ולא מועבר לגורמים נוספים.' },
  { q: 'האם חייבים לעבוד עם היועץ?', a: 'לא. הבדיקה אינה מחייבת. מומלץ להשוות הצעות מכמה גורמים, בנקים ויועצים, לפני שמחליטים.' },
];
---
<ProsePage
  title={`איך ${SITE.brand} מרוויחה כסף`}
  metaTitle={`איך ${SITE.brand} מרוויחה כסף ומה הקשר ליועצי המשכנתאות`}
  description="המחשבונים חינמיים. האתר מרוויח רק כשמבקשים בדיקה מול יועץ משכנתאות עצמאי והיועץ משלם על ההפניה. מה לא משפיע על התוצאות ומה הקשר בינינו לבין היועצים."
  answer="המחשבונים חינמיים. האתר מרוויח רק אם ביקשתם בדיקה מול יועץ משכנתאות עצמאי, והיועץ משלם על ההפניה. זה לא משפיע על התוצאות במחשבון."
  crumbs={[{ name: 'ראשי', path: '/' }, { name: 'איך אנחנו מרוויחים', path: '/how-we-make-money/' }]}
  updated={updated}
  jsonLd={[faqLd(faq)]}
>
  <h2>בקצרה</h2>
  <ul>
    <li><Icon name="check" /> צפייה בתוצאות ושימוש במחשבונים: חינם, בלי פרטים.</li>
    <li><Icon name="check" /> בקשת בדיקה מול יועץ: חינם גם היא, וזה המקום היחיד שבו נכנס לאתר כסף.</li>
    <li><Icon name="check" /> את ההפניה משלם היועץ, לא אתם.</li>
  </ul>

  <h2>איך זה עובד</h2>
  <ol>
    <li>מזינים נתונים ומקבלים תוצאה מיד, בלי טלפון ובלי מייל.</li>
    <li>בסוף החישוב אפשר לבחור לבקש בדיקה חינם. זו החלטה שלכם, והיא דורשת אישור מפורש (תיבת סימון) לכך שיועצים יחזרו אליכם.</li>
    <li>מי שמבקש בדיקה מועבר ליועץ משכנתאות עצמאי אחד בלבד. כרגע הפניות מועברות ליועץ אחד. המספר לא נמכר לגורמים נוספים.</li>
    <li>היועץ משלם לאתר על ההפניה.</li>
  </ol>

  <h2>מה הקשר בין האתר לבין היועצים</h2>
  <p>היועץ עצמאי: הוא אינו עובד של האתר, והאתר אינו נותן ייעוץ, אינו מתווך אשראי ואינו מעורב בעסקה בינכם לבין היועץ או הבנק. מה שהיועץ ימליץ ומה שיגבה, אם בכלל, נקבע ביניכם. האתר אינו ערב להמלצות ולתוצאות של היועץ.</p>
  <p>לאתר יש אינטרס עסקי בכך שתבקשו בדיקה, ואנחנו אומרים את זה במפורש. לכן אנחנו מציגים את התוצאה לפני שמבקשים פרטים, לא מסתירים את הנתונים שמאחוריה, ואומרים כשאין חיסכון.</p>

  <h2>מה לא משפיע על התוצאות</h2>
  <ul>
    <li>התוצאה מחושבת לפני שמבקשים פרטים ולא תלויה בשאלה אם תבקשו בדיקה.</li>
    <li>ריביות ונתוני שוק מגיעים מבנק ישראל ומרשות המסים, לא מגורם מסחרי.</li>
    <li>נכון להיום אין באתר פרסומות ואין תשלום מבנקים על הצגה או מיקום.</li>
    <li>ההנחות והנוסחאות גלויות ב<a href="/methodology/">עמוד המתודולוגיה</a>.</li>
  </ul>

  <h2>מה קורה עם הפרטים שלכם</h2>
  <p>מי שלא מבקש בדיקה לא מוסר שום פרט. מי שמבקש, פרטיו מועברים ליועץ אחד בלבד לצורך יצירת קשר לגבי הבדיקה. הפירוט המלא ב<a href="/privacy/">מדיניות הפרטיות</a>.</p>

  <h2>מה כדאי לעשות בכל מקרה</h2>
  <p>גם אם אתם לא מבקשים בדיקה מאיתנו, מומלץ להשוות הצעות מכמה בנקים ויועצים, ולבקש מהבנק דוח יתרות לסילוק לפני מחזור. המחשבונים כאן נועדו לעזור לכם לשאול שאלות טובות, לא להחליף אותן.</p>

  <h2>שאלות נפוצות</h2>
  <div class="faq">
    {faq.map((f) => <details><summary>{f.q}<Icon name="chevron-down" /></summary><div><p>{f.a}</p></div></details>)}
  </div>

  <p class="meta-line">שאלות על העמוד? <a href={SITE.contactPath}>צרו קשר</a>. עוד עלינו: <a href="/about/">אודות</a>.</p>
</ProsePage>
