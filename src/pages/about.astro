---
import ProsePage from '../layouts/ProsePage.astro';
import Icon from '../components/Icon.astro';
import { SITE } from '../config/site';
import { CALCULATORS } from '../config/calculators';
import { aboutPageLd, faqLd } from '../seo/schema';
import { datasets } from '../../lib/data';
import { hebrewMonth } from '../ui/dates';

const period = hebrewMonth(String(datasets.rates.period.value));
const updated = '2026-09-28';
const faq = [
  { q: `מי עומד מאחורי ${SITE.brand}?`, a: `${SITE.brand} היא יוזמה עצמאית בבעלות פרטית. האתר אינו שייך לבנק, לחברת ביטוח, לרשת יועצים או למתווך. שמות המפעילים אינם מפורסמים באתר; במקומם מפורסם כל מה שאפשר לבדוק: הנוסחאות, ההנחות והמקורות של כל מספר.` },
  { q: 'למה האתר בחינם?', a: 'המחשבונים חינמיים ואינם דורשים הרשמה. האתר מרוויח רק כשמבקשים בדיקה מול יועץ והיועץ משלם על ההפניה. הפרטים מופיעים בעמוד "איך אנחנו מרוויחים".' },
  { q: 'האם התוצאות מוטות לטובת יועץ או בנק?', a: 'לא. התוצאות מחושבות מהנתונים שהזנתם ומקבצי נתונים ציבוריים, לפני שמבקשים פרטים, ואף גורם מסחרי אינו משפיע על החישוב. כשאין חיסכון, האתר אומר את זה.' },
  { q: 'איך מדווחים על טעות?', a: 'דרך טופס יצירת הקשר. כל תיקון בנתונים מתעדכן בקובץ הנתונים ומופיע בכל העמודים, עם תאריך עדכון חדש.' },
];
---
<ProsePage
  title={`אודות ${SITE.brand}`}
  metaTitle="אודות: למה האתר קיים ולמה לסמוך עליו"
  description={`${SITE.brand}: למה האתר קיים, איך הוא עובד, איך הוא מתממן ואיך אפשר לבדוק כל מספר בו.`}
  answer="אתר מחשבונים עצמאי שמראה קודם תוצאה ורק אחר כך שואל שאלות. כל מספר בא עם הנחות, מקור ותאריך עדכון, ואפשר לבדוק אותו."
  crumbs={[{ name: 'ראשי', path: '/' }, { name: 'אודות', path: '/about/' }]}
  updated={updated}
  jsonLd={[aboutPageLd({ name: `אודות ${SITE.brand}`, description: SITE.tagline, path: '/about/', dateModified: updated }), faqLd(faq)]}
>
  <h2>למה האתר קיים</h2>
  <p>מי שבודק משכנתא נתקל בדרך כלל באחד משניים: אתר שמבקש טלפון לפני שנתן תשובה, או מדריך כללי בלי מספרים. רצינו כלי שמתחיל מהתשובה: כמה החזר, כמה חיסכון, כמה מזומן צריך. רק מי שרוצה לדבר עם יועץ מוסר פרטים, ורק אחרי שראה תוצאה.</p>

  <h2>מי עומד מאחורי האתר</h2>
  <p>{SITE.brand} היא יוזמה עצמאית בבעלות פרטית. האתר אינו שייך לבנק, לחברת ביטוח, לרשת יועצים או למתווך, ואיננו בנק, מתווך אשראי או נותן ייעוץ פיננסי.</p>
  <p>שמות המפעילים אינם מפורסמים באתר. במקום אמון בשם, אנחנו מציעים אמון שאפשר לבדוק: כל נוסחה, כל הנחה וכל מקור מפורסמים ב<a href="/methodology/">עמוד המתודולוגיה</a>, ועל כל עמוד פיננסי מופיעים מקור הנתונים ותאריך העדכון.</p>

  <h2>איך האתר עובד</h2>
  <ol>
    <li><strong>נתוני שוק ממקורות רשמיים.</strong> ריביות מבנק ישראל (כרגע נתוני {period}), מגבלות מימון מהוראה 329 של בנק ישראל ומדרגות מס רכישה מרשות המסים. כל נתון שמור בקובץ נתונים עם מקור ותאריך, ואינו כתוב בתוך הקוד.</li>
    <li><strong>חישוב שקוף.</strong> אותן פונקציות חישוב משמשות את כל {CALCULATORS.length} <a href="/calculators/">המחשבונים</a>, כך שהמספרים עקביים ביניהם. התוצאות מוצגות כטווח כשיש אי־ודאות, ולא כמספר מבטיח.</li>
    <li><strong>הנחות גלויות.</strong> כל תוצאה מציגה את ההנחות שלה. מה שלא נכלל, כמו הצמדה למדד במחשבון המחזור, מצוין במפורש.</li>
    <li><strong>עדכון.</strong> הטבלאות מתעדכנות כשבנק ישראל מפרסם חודש חדש, בדרך כלל באמצע החודש. בכל עמוד מופיע תאריך העדכון האחרון.</li>
  </ol>

  <h2>איך האתר מתממן</h2>
  <p>המחשבונים חינמיים. בסוף החישוב אפשר לבקש בדיקה חינם מול יועץ משכנתאות עצמאי, והיועץ משלם על ההפניה. כל הפרטים, כולל מה לא משפיע על התוצאות, ב<a href="/how-we-make-money/">עמוד איך אנחנו מרוויחים</a>.</p>

  <h2>למה אפשר לסמוך על האתר</h2>
  <ul>
    <li><Icon name="check" /> <strong>תוצאה לפני פרטים.</strong> לא מבקשים טלפון או מייל כדי להראות מספרים.</li>
    <li><Icon name="check" /> <strong>כנות כשאין חיסכון.</strong> אם מחזור לא צפוי לחסוך, האתר אומר זאת.</li>
    <li><Icon name="check" /> <strong>מקור ותאריך לכל נתון.</strong> אפשר ללחוץ ולהגיע למקור הרשמי.</li>
    <li><Icon name="check" /> <strong>החישוב בשרת נבדק מחדש.</strong> כשמשאירים פרטים, המספרים מחושבים שוב בשרת ולא נסמכים על מה שהדפדפן שלח.</li>
    <li><Icon name="check" /> <strong>יועץ אחד בלבד.</strong> מי שמבקש בדיקה מועבר ליועץ אחד, והמספר לא נמכר לגורמים נוספים.</li>
    <li><Icon name="check" /> <strong>הצהרת גבולות.</strong> המחשבונים נותנים הערכה ואינם ייעוץ פיננסי או אישור עקרוני מבנק.</li>
  </ul>

  <h2>מדיניות תיקונים</h2>
  <p>מצאתם נתון שגוי או הנחה שנראית לא סבירה? כתבו לנו ב<a href={SITE.contactPath}>טופס יצירת הקשר</a>. תיקון בנתונים נעשה בקובץ הנתונים ומתעדכן בכל העמודים יחד, עם תאריך עדכון חדש.</p>

  <h2>שאלות נפוצות</h2>
  <div class="faq">
    {faq.map((f) => <details><summary>{f.q}<Icon name="chevron-down" /></summary><div><p>{f.a}</p></div></details>)}
  </div>

  <h2>יצירת קשר</h2>
  <p>אפשר לפנות אלינו דרך <a href={SITE.contactPath}>טופס יצירת הקשר</a>.</p>
</ProsePage>
