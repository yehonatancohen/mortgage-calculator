---
import CalculatorPage from '../layouts/CalculatorPage.astro';
import RefinanceCalculator from '../components/refinance/RefinanceCalculator.astro';
import Icon from '../components/Icon.astro';
import { datasets, refinanceAssumptions } from '../../lib/data';
import { formatILS, formatILSRange, formatPercent, refinanceSavings, headline } from '../../lib/mortgage';
import { REFI } from '../config/calculator';
import { hebrewMonth } from '../ui/dates';
import { costsRange } from '../ui/refinanceView';

const a = refinanceAssumptions();
const updated = datasets.rates.tracks.prime.lastUpdated;
const period = hebrewMonth(String(datasets.rates.period.value));

const examples = [
  { name: 'ברירת המחדל במחשבון', balance: REFI.defaults.balance, payment: REFI.defaults.payment, years: REFI.defaults.years },
  { name: 'משכנתא יקרה יותר', balance: 1_200_000, payment: 8_300, years: 22 },
].map((e) => {
  const r = refinanceSavings({ balance: e.balance, monthlyPayment: e.payment, months: e.years * 12 }, a);
  if (!r.ok) throw new Error(`Worked example is invalid: ${e.name}`);
  const h = headline(r);
  // The Hebrew prefix stays outside the LTR-isolated figure so "עד" lands on the right.
  const result =
    h.kind === 'range' ? { prefix: '', figure: formatILSRange(h.low, h.high) }
    : h.kind === 'upTo' ? { prefix: 'עד ', figure: formatILS(h.high) }
    : { prefix: 'אין חיסכון משמעותי', figure: '' };
  return { ...e, r, h, result, saves: h.kind === 'range' || h.kind === 'upTo' };
});
const r10 = (n: number) => Math.floor(n / 10) * 10;

const faq = [
  {
    q: 'מתי כדאי למחזר משכנתא?',
    a: 'בדרך כלל כשהריבית שלך גבוהה במידה ניכרת מהריבית שהבנקים נותנים היום, ונשארו מספיק שנים כדי שהחיסכון יעלה על עמלת הפירעון המוקדם ועלויות המעבר. המחשבון מחשב את הפער הזה מהנתונים שלך.',
  },
  {
    q: 'למה התוצאה מוצגת כטווח ולא כמספר אחד?',
    a: 'הריבית שתקבל/י תלויה בפרופיל שלך ובתמהיל המסלולים, ועמלת הפירעון תלויה במסלולים הקיימים. לכן אנחנו מחשבים תרחיש שמרני ותרחיש אופטימי ומציגים את הטווח ביניהם. אם בתרחיש השמרני אין חיסכון, מוצג רק הסכום המרבי.',
  },
  {
    q: 'האם החישוב כולל את עמלת הפירעון המוקדם?',
    a: 'כן. החיסכון המוצג הוא נטו: אחרי הערכה של עמלת הפירעון המוקדם ושל עלויות מעבר כמו שמאות ופתיחת תיק. ההערכה פשוטה ביודעין; את העמלה המדויקת הבנק מחשב לפי המסלולים שלך.',
  },
  {
    q: 'האם צריך להשאיר פרטים כדי לראות תוצאה?',
    a: 'לא. התוצאה מוצגת מיד ובלי פרטים. רק אם תרצה/י שיועץ יבדוק את המשכנתא, נבקש שם וטלפון ונאמת את המספר ב־SMS.',
  },
  {
    q: 'מה קורה עם הטלפון שלי אם אבקש בדיקה?',
    a: 'הפרטים מועברים ליועץ משכנתאות עצמאי אחד בלבד, שיחזור אליך. המספר לא נמכר ולא מועבר לגורמים נוספים.',
  },
];
---
<CalculatorPage
  title="מחשבון מחזור משכנתא"
  metaTitle="מחשבון מחזור משכנתא: כמה תחסכו? תוצאה מיידית בלי פרטים"
  description="מחשבון מחזור משכנתא: הזינו יתרה, החזר חודשי ושנים שנותרו, ותראו מיד טווח חיסכון נטו אחרי עמלת פירעון מוקדם. בלי להשאיר פרטים."
  answer="האם מחזור יחסוך לכם, וכמה. בלי להשאיר פרטים."
  appName="מחשבון מחזור משכנתא"
  updated={updated}
  faq={faq}
  crumbs={[{ name: 'ראשי', path: '/' }]}
  sources={[
    { label: 'בנק ישראל: דוח חודשי על הלוואות לדיור', url: 'https://www.boi.org.il/roles/statistics/banking/housing_cred/monthly-report-on-housing-loans/' },
    { label: 'צו הבנקאות (פירעון מוקדם של הלוואה לדיור), התשס"ב-2002', url: 'https://www.boi.org.il/media/qy5cow0l/116.pdf' },
  ]}
  next={{ href: '/calculators/prepayment-fee/', title: 'כמה תעלה עמלת הפירעון המוקדם?', text: 'חשבו את העמלה על מסלול קבוע לפני שמחליטים.' }}
>
  <RefinanceCalculator />

  <Fragment slot="example">
    <p>לפי ריביות ממוצעות מ{period}, אחרי עמלות ועלויות מעבר.</p>
    <div class="examples">
      {examples.map((ex) => (
        <article class="example">
          <h3 class="example__title">{ex.name}</h3>
          <ul class="example__inputs">
            <li><span class="example__key"><Icon name="home" />יתרה</span><bdi class="num">{formatILS(ex.balance)}</bdi></li>
            <li><span class="example__key"><Icon name="calendar" />החזר חודשי</span><bdi class="num">{formatILS(ex.payment)}</bdi></li>
            <li><span class="example__key"><Icon name="clock" />שנים</span><bdi class="num">{ex.years}</bdi></li>
          </ul>
          <p class="example__result">
            <span class="example__result-label">חיסכון נטו אפשרי</span>
            <span class:list={['example__figure', { 'example__figure--none': !ex.saves }]}>{ex.result.prefix}{ex.result.figure && <bdi class="num">{ex.result.figure}</bdi>}</span>
          </p>
          <details class="example__more">
            <summary>כל החישוב<Icon name="chevron-down" /></summary>
            <div class="table-wrap">
              <table class="data-table">
                <caption class="visually-hidden">{ex.name}: פירוט החישוב</caption>
                <tbody>
                  <tr><th scope="row">ריבית אפקטיבית נוכחית</th><td class="num">{formatPercent(ex.r.currentRate)}</td></tr>
                  <tr><th scope="row">ריבית במחזור (טווח)</th><td class="num">{formatPercent(ex.r.newRate.low)}–{formatPercent(ex.r.newRate.high)}</td></tr>
                  <tr><th scope="row">החזר חודשי אחרי מחזור</th><td class="num">{formatILSRange(r10(ex.r.newPayment.low), r10(ex.r.newPayment.high))}</td></tr>
                  <tr><th scope="row">עמלת פירעון ועלויות מעבר</th><td class="num">{costsRange(ex.r)}</td></tr>
                  <tr class="is-total"><th scope="row">חיסכון נטו אפשרי</th><td>{ex.result.prefix}{ex.result.figure && <bdi class="num">{ex.result.figure}</bdi>}</td></tr>
                </tbody>
              </table>
            </div>
          </details>
        </article>
      ))}
    </div>
    <p class="meta-line">עיגול כלפי מטה לאלף שקלים. הערכה בלבד.</p>
  </Fragment>

  <Fragment slot="explanation">
    <p><strong>מחזור משכנתא</strong> הוא החלפת המשכנתא בהלוואה חדשה, באותו בנק או בבנק אחר. הוא משתלם רק כשהחיסכון בריבית גדול מהעלויות.</p>
    <ol class="how">
      <li>
        <span class="how__icon"><Icon name="percent" /></span>
        <div>
          <h3 class="how__title">מחשבים את הריבית שלך</h3>
          <p>מתוך היתרה, ההחזר החודשי והשנים שנותרו.</p>
        </div>
      </li>
      <li>
        <span class="how__icon"><Icon name="compare" /></span>
        <div>
          <h3 class="how__title">משווים לריבית של היום</h3>
          <p>טווח סביב הריבית הממוצעת למשכנתא חדשה, לפי בנק ישראל.</p>
        </div>
      </li>
      <li>
        <span class="how__icon"><Icon name="receipt" /></span>
        <div>
          <h3 class="how__title">מחסירים את העלויות</h3>
          <p>עמלת פירעון מוקדם ועלויות מעבר. מה שנשאר הוא החיסכון נטו.</p>
        </div>
      </li>
    </ol>
    <p class="notice notice--quiet"><Icon name="info" class="notice__icon" />החישוב לא כולל הצמדה למדד. במסלולים צמודים ההחזר בפועל ישתנה עם המדד.</p>
  </Fragment>
</CalculatorPage>
