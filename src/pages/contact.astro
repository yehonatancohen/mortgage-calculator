---
import ProsePage from '../layouts/ProsePage.astro';
import { SITE } from '../config/site';
---
<ProsePage
  title="יצירת קשר"
  description={`טופס יצירת קשר עם צוות ${SITE.brand}.`}
  crumbs={[{ name: 'ראשי', path: '/' }, { name: 'יצירת קשר', path: '/contact/' }]}
>
  <div data-contact>
    <div data-stage="form">
      <p>נשמח לשמוע. נחזור אליך לכתובת האימייל שתשאיר/י כאן.</p>
      <form data-contact-form novalidate>
        <div class="field">
          <label class="field__label" for="contact-name">שם</label>
          <input class="input" id="contact-name" name="name" type="text" autocomplete="name" required />
        </div>
        <div class="field">
          <label class="field__label" for="contact-email">אימייל</label>
          <input class="input input--ltr" id="contact-email" name="email" type="email" inputmode="email" autocomplete="email" required />
        </div>
        <div class="field">
          <label class="field__label" for="contact-message">הודעה</label>
          <textarea class="input" id="contact-message" name="message" rows="5" required></textarea>
        </div>
        <div class="hp" aria-hidden="true">
          <label>אל תמלאו שדה זה <input type="text" name="company" tabindex="-1" autocomplete="off" /></label>
        </div>
        <p class="form-error" role="alert" data-form-error hidden></p>
        <button type="submit" class="btn btn--primary">שליחה</button>
      </form>
    </div>
    <div data-stage="done" hidden>
      <p>ההודעה נשלחה. נחזור אליך בהקדם.</p>
    </div>
  </div>
</ProsePage>

<script>
  document.querySelectorAll<HTMLElement>('[data-contact]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-contact-form]');
    const errorEl = root.querySelector<HTMLElement>('[data-form-error]');
    const formStage = root.querySelector<HTMLElement>('[data-stage="form"]');
    const doneStage = root.querySelector<HTMLElement>('[data-stage="done"]');
    if (!form || !errorEl || !formStage || !doneStage) return;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      errorEl.hidden = true;
      const data = new FormData(form);
      const hp = String(data.get('company') ?? '');
      const name = String(data.get('name') ?? '').trim();
      const email = String(data.get('email') ?? '').trim();
      const message = String(data.get('message') ?? '').trim();
      const submitBtn = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (submitBtn) submitBtn.disabled = true;
      try {
        const res = await fetch('/api/contact/', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify({ name, email, message, entryPage: location.pathname, hp }),
        });
        const body = (await res.json().catch(() => null)) as { ok?: boolean } | null;
        if (!res.ok || !body?.ok) throw new Error('failed');
        formStage.hidden = true;
        doneStage.hidden = false;
      } catch {
        errorEl.textContent = 'משהו השתבש. אפשר לנסות שוב, או לפנות אלינו במייל אחר.';
        errorEl.hidden = false;
      } finally {
        if (submitBtn) submitBtn.disabled = false;
      }
    });
  });
</script>
