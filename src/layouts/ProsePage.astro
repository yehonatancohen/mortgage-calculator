---
/** Reading layout for guides, legal and information pages. */
import Base from './Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Icon from '../components/Icon.astro';
import type { Crumb } from '../seo/schema';
import { hebrewDate } from '../ui/dates';

interface Props {
  title: string;
  metaTitle?: string;
  description: string;
  answer?: string;
  crumbs: Crumb[];
  updated?: string;
  jsonLd?: Record<string, unknown>[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  draft?: boolean;
  related?: { href: string; title: string; text: string }[];
}
const { title, metaTitle = title, description, answer, crumbs, updated, jsonLd, noindex, ogType, draft, related = [] } = Astro.props;
---
<Base title={metaTitle} description={description} breadcrumbs={crumbs} jsonLd={jsonLd} noindex={noindex} ogType={ogType}>
  <main id="main" class="page">
    <Breadcrumbs crumbs={crumbs} />
    <article class="article">
      <header class="article__head">
        <h1>{title}</h1>
        {answer && <p class="page-intro__answer">{answer}</p>}
        {updated && <p class="meta-line">עודכן לאחרונה: <time datetime={updated}>{hebrewDate(updated)}</time></p>}
        {draft && <p class="draft-note">טיוטה: מבנה הכותרות מוכן, והתוכן ייכתב וייבדק לפני פרסום. העמוד לא מאונדקס.</p>}
      </header>
      <div class="prose">
        <slot />
      </div>
      {related.length > 0 && (
        <aside class="article__related" aria-label="המשך">
          {related.map((r) => (
            <a class="next-link" href={r.href}>
              <span><span class="next-link__title">{r.title}</span><br /><span class="next-link__text">{r.text}</span></span>
              <Icon name="arrow-left" />
            </a>
          ))}
        </aside>
      )}
    </article>
  </main>
</Base>

<style>
  .article {
    max-inline-size: 42rem;
    margin-inline: auto;
    padding-block: var(--space-8) 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-8);
  }
  .article__head {
    display: grid;
    gap: var(--space-3);
  }
  .article__related {
    display: grid;
    gap: var(--space-3);
    margin-block-start: var(--space-8);
  }
</style>
