---
import '../styles/base.css';
import '../styles/components.css';
import '../styles/layout.css';
import '../styles/calculator.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { INTEGRATIONS, SITE } from '../config/site';
import { organizationLd, websiteLd, breadcrumbLd, type Crumb } from '../seo/schema';

interface Props {
  title: string;
  description: string;
  /** Page-specific JSON-LD objects (WebApplication, FAQPage, Article, Dataset...). */
  jsonLd?: Record<string, unknown>[];
  breadcrumbs?: Crumb[];
  noindex?: boolean;
  /** Path of the OG image (defaults to the generated one for this page). */
  ogImage?: string;
  ogType?: 'website' | 'article';
  bare?: boolean;
}
const { title, description, jsonLd = [], breadcrumbs, noindex = false, ogType = 'website', bare = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, SITE.url).href;
const ogPath = Astro.props.ogImage ?? `/og${path === '/' ? '/index' : path.replace(/\/$/, '')}.png`;
const ogImage = new URL(ogPath, SITE.url).href;
const fullTitle = path === '/' ? title : `${title} | ${SITE.brand}`;
const ld = [organizationLd(), ...(path === '/' ? [websiteLd()] : []), ...(breadcrumbs ? [breadcrumbLd(breadcrumbs)] : []), ...jsonLd];
---
<!doctype html>
<html lang={SITE.lang} dir={SITE.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="preload" href="/fonts/heebo-hebrew.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/heebo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f3f6f8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0c1114" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {INTEGRATIONS.googleSiteVerification && <meta name="google-site-verification" content={INTEGRATIONS.googleSiteVerification} />}
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">דלג לתוכן</a>
    {!bare && <SiteHeader />}
    <slot />
    {!bare && <SiteFooter />}
    <script>
      import { initAnalytics } from '../scripts/analytics';
      initAnalytics();
    </script>
    {INTEGRATIONS.clarityId && (
      <script is:inline define:vars={{ id: INTEGRATIONS.clarityId }}>
        const load = () => { (function (c, l, a, r, i, t, y) { c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); }; t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i; y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y); })(window, document, 'clarity', 'script', id); };
        'requestIdleCallback' in window ? requestIdleCallback(load, { timeout: 4000 }) : addEventListener('load', () => setTimeout(load, 1500));
      </script>
    )}
  </body>
</html>
