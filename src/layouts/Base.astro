---
import '../styles/base.css';
import '../styles/components.css';
import '../styles/layout.css';
import '../styles/calculator.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { INTEGRATIONS, SITE } from '../config/site';
import { organizationLd, websiteLd, breadcrumbLd, type Crumb } from '../seo/schema';

interface Props {
  title: string;
  description: string;
  /** Page-specific JSON-LD objects (WebApplication, FAQPage, Article, Dataset...). */
  jsonLd?: Record<string, unknown>[];
  breadcrumbs?: Crumb[];
  noindex?: boolean;
  /** Path of the OG image (defaults to the generated one for this page). */
  ogImage?: string;
  ogType?: 'website' | 'article';
  bare?: boolean;
}
const { title, description, jsonLd = [], breadcrumbs, noindex = false, ogType = 'website', bare = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, SITE.url).href;
const ogPath = Astro.props.ogImage ?? `/og${path === '/' ? '/index' : path.replace(/\/$/, '')}.png`;
const ogImage = new URL(ogPath, SITE.url).href;
const fullTitle = path === '/' ? title : `${title} | ${SITE.brand}`;
const ld = [organizationLd(), ...(path === '/' ? [websiteLd()] : []), ...(breadcrumbs ? [breadcrumbLd(breadcrumbs)] : []), ...jsonLd];
---
<!doctype html>
<html lang={SITE.lang} dir={SITE.dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex ? <meta name="robots" content="noindex, follow" /> : <meta name="robots" content="index, follow, max-image-preview:large" />}
    <link rel="preload" href="/fonts/heebo-hebrew.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/heebo-latin.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="theme-color" content="#f3f6f8" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="he_IL" />
    <meta property="og:site_name" content={SITE.brand} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    {INTEGRATIONS.googleSiteVerification && <meta name="google-site-verification" content={INTEGRATIONS.googleSiteVerification} />}
    <script is:inline>
      try { const t = localStorage.getItem('theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}
    </script>
    {ld.map((obj) => <script type="application/ld+json" set:html={JSON.stringify(obj)} />)}
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">דלג לתוכן</a>
    {!bare && <SiteHeader />}
    <slot />
    {!bare && <SiteFooter />}
    <script is:inline>
      // Owner test mode (turned on at /admin/test-mode/, see src/server/testmode.ts). The server
      // enforces it for the beacon and leads; this readable hint cookie only makes the browser skip
      // GA4/Clarity too, and shows a banner so you can see it is on before sending a test lead.
      if (/(?:^|;\s*)mc_test_ui=1(?:;|$)/.test(document.cookie)) {
        const b = document.createElement('a');
        b.href = '/admin/test-mode/';
        b.className = 'test-mode-banner';
        b.textContent = 'מצב בדיקה: הביקור והלידים לא נספרים';
        document.body.prepend(b);
      }
    </script>
    {/* Operator pages (admin, the advisor's lead link) are never counted as visits. */}
    {!bare && (
      <script>
        import { initAnalytics } from '../scripts/analytics';
        initAnalytics();
      </script>
    )}
    {!bare && INTEGRATIONS.clarityId && (
      <script is:inline define:vars={{ id: INTEGRATIONS.clarityId }}>
        const load = () => {
          if (/(?:^|;\s*)mc_test_ui=1(?:;|$)/.test(document.cookie)) return;
          (function (c, l, a, r, i, t, y) { c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); }; t = l.createElement(r); t.async = 1; t.src = 'https://www.clarity.ms/tag/' + i; y = l.getElementsByTagName(r)[0]; y.parentNode.insertBefore(t, y); })(window, document, 'clarity', 'script', id);
          // Tag Clarity recordings with the same session id analytics.ts uses, so tachles-admin
          // can link a session's journey to its recording. Read directly from sessionStorage
          // (not imported from analytics.ts) since this script runs before Clarity's own tag has
          // loaded — calling window.clarity() any earlier would be a no-op.
          try { const sid = sessionStorage.getItem('mc_session'); if (sid) window.clarity('set', 'session_id', sid); } catch {}
        };
        'requestIdleCallback' in window ? requestIdleCallback(load, { timeout: 4000 }) : addEventListener('load', () => setTimeout(load, 1500));
      </script>
    )}

    {!bare && INTEGRATIONS.ga4Id && (
      <script is:inline define:vars={{ id: INTEGRATIONS.ga4Id }}>
        const loadGa4 = () => {
          if (/(?:^|;\s*)mc_test_ui=1(?:;|$)/.test(document.cookie)) return;
          const s = document.createElement('script');
          s.async = true;
          s.src = 'https://www.googletagmanager.com/gtag/js?id=' + id;
          document.head.appendChild(s);
          window.dataLayer = window.dataLayer || [];
          window.gtag = function () { window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', id, { anonymize_ip: false });
        };
        'requestIdleCallback' in window ? requestIdleCallback(loadGa4, { timeout: 4000 }) : addEventListener('load', () => setTimeout(loadGa4, 1500));
      </script>
    )}
  </body>
</html>
