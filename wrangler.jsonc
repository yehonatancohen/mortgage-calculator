{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "mortgage-website",
	"compatibility_date": "2026-09-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist/client",
		"binding": "ASSETS"
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "mortgage-leads",
			"database_id": "082917c3-a3aa-4d79-904f-d5a04839732c",
			"migrations_dir": "migrations"
		},
		{
			// Owned by the sibling tachles-admin project (same database_id as its ANALYTICS binding
			// in tachles-admin/wrangler.jsonc). This project only ever writes to it via /api/t;
			// migrations live in tachles-admin/migrations.
			"binding": "ANALYTICS",
			"database_name": "tachles-analytics",
			"database_id": "23d2663a-37b2-4cd3-9c84-82a4e13fa2ae"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "b0be4cf56eaf49878b35d0ba5d9a53b2"
		}
	]
}